# Copy to streams/<id>.conf (e.g. streams/frontdoor.conf), one file per camera.
# Each config needs its own YouTube stream key. This file holds passwords:
#   chmod 600 streams/*.conf

# Used in broadcast titles: "CCTV (2026-08-30 10-30)"
NAME="CCTV"

RTSP_URL="rtsp://admin:password@192.168.1.1/stream1"

# YouTube Studio > Go live > Stream key (must be a different key per camera).
STREAM_KEY="xxxx-xxxx-xxxx-xxxx-xxxx"

# YouTube account to stream to. Create one token per account with:
#   yutu auth --credential client_secret.json --cacheToken tokens/myaccount.token.json
# Relative paths are resolved against the folder livestream.sh is in.
#TOKEN_FILE="youtube.token.json"
#CREDENTIAL_FILE="client_secret.json"

# Optional: YouTube stream id; looked up from STREAM_KEY when empty.
#STREAM_ID=""

# Optional: ingest URL. Defaults to YouTube's HLS ingest for STREAM_KEY.
#INGEST_URL="rtmp://a.rtmp.youtube.com/live2/$STREAM_KEY"

# Time each broadcast stays live before it's ended and a new one starts.
# Keep a margin under 12h: longer broadcasts can get stuck on "Processing will
# begin shortly" and lose DVR.
DURATION="11h55m"

PRIVACY="unlisted"        # public | unlisted | private
DESCRIPTION=""

# Optional: add each broadcast to a playlist once it's live (from the playlist
# URL: youtube.com/playlist?list=<PLAYLIST_ID>). Comma separate for several.
# The playlist must belong to the same account as TOKEN_FILE.
#PLAYLIST_ID="PLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: stream latency. normal (default) | low | ultraLow
# Lower latency means less delay but more buffering for viewers on slow
# connections. ultraLow doesn't support closed captions.
#LATENCY="normal"

# Optional: closed captions. disabled (default) | embedded | http
#   embedded: captions embedded in the video stream (CEA-608/708)
#   http:     captions sent separately over HTTP POST
#CAPTIONS="disabled"

# ffmpeg options (arrays). Defaults match the original stream.sh.
#FFMPEG_INPUT_ARGS=(-rtsp_transport tcp)
#FFMPEG_OUTPUT_ARGS=(-c:v copy -c:a libopus -b:a 96k)

# If you set INGEST_URL to RTMP, use an RTMP-compatible format and codec, e.g.:
#FFMPEG_OUTPUT_ARGS=(-c:v copy -c:a aac -b:a 128k -f flv)

# Timeouts (seconds)
#GO_LIVE_TIMEOUT=300
#RETRY_DELAY=120
#FFMPEG_CHECK_INTERVAL=10
